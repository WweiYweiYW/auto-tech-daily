[Unit]
Description=Collect every two hours and send digest at 18:00 Shanghai time

[Timer]
OnCalendar=*-*-* 00/2:17:00 Asia/Shanghai
OnCalendar=*-*-* 18:00:00 Asia/Shanghai
OnCalendar=*-*-* 18:07:00 Asia/Shanghai
OnCalendar=*-*-* 18:17:00 Asia/Shanghai
Persistent=true
AccuracySec=1s
RandomizedDelaySec=0
Unit=auto-tech-daily.service

[Install]
WantedBy=timers.target
