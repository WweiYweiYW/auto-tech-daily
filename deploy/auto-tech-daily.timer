[Unit]
Description=Collect every two hours and refresh digest at midday

[Timer]
OnCalendar=*-*-* 00/2:17:00 Asia/Shanghai
OnCalendar=*-*-* 12:30:00 Asia/Shanghai
OnCalendar=*-*-* 12:37:00 Asia/Shanghai
OnCalendar=*-*-* 12:47:00 Asia/Shanghai
Persistent=true
AccuracySec=1s
RandomizedDelaySec=0
Unit=auto-tech-daily.service

[Install]
WantedBy=timers.target
