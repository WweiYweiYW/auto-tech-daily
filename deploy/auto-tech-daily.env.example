# Copy to /etc/auto-tech-daily.env with owner root:root and mode 0600.
# Edit on the server only. Do not commit the completed file or paste it in chat.
DAILY_STATE_PATH=/var/lib/auto-tech-daily/state.json
SEND_TIME=18:00
WEB_OUTPUT_DIR=/var/lib/auto-tech-daily/site
# REQUIRED before starting the service: public HTTP(S) entry URL, no credentials.
# Only empty path, / or /index.html; no query, fragment or custom /daily/ path.
# An IP with HTTP is for temporary testing only; use your own HTTPS domain later.
WEB_BASE_URL=
WEB_REMINDER_CHANNEL=email
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_TO=
# For Feishu instead, set WEB_REMINDER_CHANNEL=feishu and fill these on server.
FEISHU_WEBHOOK=
FEISHU_SIGN_SECRET=
